{
  "$defs": {
    "AnswerabilityReport": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/FinishAction"
        },
        "answerable": {
          "title": "Answerable",
          "type": "boolean"
        },
        "conflicted_claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Conflicted Claim Ids",
          "type": "array"
        },
        "evidence_source_count": {
          "default": 0,
          "title": "Evidence Source Count",
          "type": "integer"
        },
        "independent_domain_count": {
          "default": 0,
          "title": "Independent Domain Count",
          "type": "integer"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "stale_claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Stale Claim Ids",
          "type": "array"
        },
        "unresolved_questions": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Questions",
          "type": "array"
        },
        "unsupported_claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unsupported Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "answerable",
        "action"
      ],
      "title": "AnswerabilityReport",
      "type": "object"
    },
    "FinishAction": {
      "enum": [
        "answer",
        "search_more",
        "clarify",
        "abstain"
      ],
      "title": "FinishAction",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "created",
        "running",
        "waiting",
        "verifying",
        "completed",
        "abstained",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/FinishAction"
    },
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "answerability": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnswerabilityReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "citations": {
      "items": {
        "type": "string"
      },
      "title": "Citations",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "state_revision": {
      "minimum": 0,
      "title": "State Revision",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "status",
    "action",
    "answer",
    "state_revision",
    "trace_id"
  ],
  "title": "HarnessAnswer",
  "type": "object"
}
