{
  "$defs": {
    "ActorType": {
      "enum": [
        "model",
        "system",
        "user",
        "admin",
        "importer"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "MemoryDraft": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array",
          "uniqueItems": true
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryKind"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "$ref": "#/$defs/MemoryStatus",
          "default": "active"
        },
        "summary": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "temperature": {
          "$ref": "#/$defs/MemoryTemperature",
          "default": "warm"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        }
      },
      "required": [
        "kind",
        "summary"
      ],
      "title": "MemoryDraft",
      "type": "object"
    },
    "MemoryKind": {
      "enum": [
        "global_invariant",
        "current_state",
        "open_goal",
        "active_evidence",
        "resolved_evidence",
        "transient_observation",
        "completed_checkpoint",
        "superseded_state",
        "conflict",
        "user_preference",
        "event_history"
      ],
      "title": "MemoryKind",
      "type": "string"
    },
    "MemoryMutation": {
      "additionalProperties": false,
      "properties": {
        "changes": {
          "additionalProperties": true,
          "title": "Changes",
          "type": "object"
        },
        "draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryDraft"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "operation": {
          "$ref": "#/$defs/MemoryOperationType"
        },
        "purge_confirmation_token": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purge Confirmation Token"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode",
          "default": "other"
        },
        "replacement_ids": {
          "items": {
            "type": "string"
          },
          "title": "Replacement Ids",
          "type": "array",
          "uniqueItems": true
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        }
      },
      "required": [
        "operation"
      ],
      "title": "MemoryMutation",
      "type": "object"
    },
    "MemoryOperationType": {
      "enum": [
        "add",
        "update",
        "merge",
        "supersede",
        "archive",
        "evict",
        "restore",
        "purge",
        "pin",
        "unpin"
      ],
      "title": "MemoryOperationType",
      "type": "string"
    },
    "MemoryStatus": {
      "enum": [
        "active",
        "archived",
        "evicted",
        "superseded",
        "purged"
      ],
      "title": "MemoryStatus",
      "type": "string"
    },
    "MemoryTemperature": {
      "enum": [
        "pinned",
        "hot",
        "warm",
        "cold"
      ],
      "title": "MemoryTemperature",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "completed_no_future_dependency",
        "superseded_by_current_state",
        "duplicate",
        "irrelevant_to_open_goals",
        "source_reduced_to_claim",
        "expired",
        "user_request",
        "policy_retention",
        "other"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorType",
      "default": "model"
    },
    "allow_purge": {
      "default": false,
      "title": "Allow Purge",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "mutations": {
      "items": {
        "$ref": "#/$defs/MemoryMutation"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Mutations",
      "type": "array"
    },
    "reason": {
      "default": "state update",
      "maxLength": 4000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "expected_revision",
    "mutations",
    "idempotency_key"
  ],
  "title": "StatePatch",
  "type": "object"
}
