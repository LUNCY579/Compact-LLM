{
  "$defs": {
    "DeleteScope": {
      "enum": [
        "active_context",
        "archive",
        "persistent_purge"
      ],
      "title": "DeleteScope",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "completed_no_future_dependency",
        "superseded_by_current_state",
        "duplicate",
        "irrelevant_to_open_goals",
        "source_reduced_to_claim",
        "expired",
        "user_request",
        "policy_retention",
        "other"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confirmation_token": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmation Token"
    },
    "expected_state_revision": {
      "minimum": 0,
      "title": "Expected State Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 8,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "memory_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Memory Ids",
      "type": "array"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "reason_code": {
      "$ref": "#/$defs/ReasonCode"
    },
    "replacement_state_ids": {
      "items": {
        "type": "string"
      },
      "title": "Replacement State Ids",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/DeleteScope",
      "default": "active_context"
    }
  },
  "required": [
    "run_id",
    "memory_ids",
    "reason_code",
    "expected_state_revision"
  ],
  "title": "DeleteMemoryRequest",
  "type": "object"
}
