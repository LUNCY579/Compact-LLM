            },
            "title": "Evidence",
            "type": "array"
          },
          "memories": {
            "items": {
              "$ref": "#/components/schemas/MemoryItem"
            },
            "title": "Memories",
            "type": "array"
          },
          "run": {
            "$ref": "#/components/schemas/RunRecord"
          }
        },
        "required": [
          "run"
        ],
        "title": "RunSnapshot",
        "type": "object"
      },
      "RunStatus": {
        "enum": [
          "created",
          "running",
          "waiting",
          "verifying",
          "completed",
          "abstained",
          "failed",
          "cancelled"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "SupportStatus": {
        "enum": [
          "supported",
          "partially_supported",
          "conflicted",
          "unsupported",
          "stale"
        ],
        "title": "SupportStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkflowBudget": {
        "additionalProperties": false,
        "properties": {
          "max_active_memory_items": {
            "default": 64,
            "maximum": 10000.0,
            "minimum": 4.0,
            "title": "Max Active Memory Items",
            "type": "integer"
          },
          "max_model_calls": {
            "default": 8,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Model Calls",
            "type": "integer"
          },
          "max_rounds": {
            "default": 3,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Rounds",
            "type": "integer"
          },
          "max_search_calls": {
            "default": 3,
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Max Search Calls",
            "type": "integer"
          },
          "max_sources_fetched": {
            "default": 8,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Max Sources Fetched",
            "type": "integer"
          },
          "max_wall_seconds": {
            "default": 90.0,
            "exclusiveMinimum": 0.0,
            "maximum": 3600.0,
            "title": "Max Wall Seconds",
            "type": "number"
          }
        },
        "title": "WorkflowBudget",
        "type": "object"
      },
      "WorkflowNode": {
        "enum": [
          "intake",
          "route",
          "search",
          "fetch",
          "extract",
          "reconstruct",
          "compact",
          "verify",
          "answer",
          "clarify",
          "abstain",
          "done",
          "error"
        ],
        "title": "WorkflowNode",
        "type": "string"
      }
    }
  },
