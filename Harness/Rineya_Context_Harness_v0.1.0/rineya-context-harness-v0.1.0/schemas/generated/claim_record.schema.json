{
  "$defs": {
    "SupportStatus": {
      "enum": [
        "supported",
        "partially_supported",
        "conflicted",
        "unsupported",
        "stale"
      ],
      "title": "SupportStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conflict_group": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conflict Group"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array",
      "uniqueItems": true
    },
    "freshness_required": {
      "default": false,
      "title": "Freshness Required",
      "type": "boolean"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "required_for_answer": {
      "default": false,
      "title": "Required For Answer",
      "type": "boolean"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "statement": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "support_status": {
      "$ref": "#/$defs/SupportStatus",
      "default": "unsupported"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "statement"
  ],
  "title": "ClaimRecord",
  "type": "object"
}
