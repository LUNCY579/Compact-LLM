digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad=0.25, nodesep=0.35, ranksep=0.45, splines=ortho];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, color="#17365D", penwidth=1.4, margin="0.14,0.08"];
  edge [color="#5B6B7C", penwidth=1.4, arrowsize=0.75];

  request [label="User Request\n+ Policy Boundary", fillcolor="#EAF1F8"];
  route [label="Deterministic Mode, Budget,\nand Permission Controller", fillcolor="#DCEAF4"];
  search [label="Search / Retrieve / Fetch / Extract", fillcolor="#E8F3F4", color="#2A7F8E"];
  ledger [label="Immutable Evidence Ledger\nSources -> Passages -> Claims", fillcolor="#E8F3F4", color="#2A7F8E"];
  reconstruct [label="Rineya Reconstruction Proposal\nCurrent state + evidence -> candidate patch", fillcolor="#F2ECF8", color="#6A4C93"];
  validate [label="Deterministic Validator\nPins, dependencies, revisions, provenance", fillcolor="#FFF3DD", color="#D98C2B"];
  commit [label="Atomic State Commit\nADD / UPDATE / MERGE / ARCHIVE / EVICT", fillcolor="#EAF5EC", color="#3C8D5A"];
  rebuild [label="Prompt + Dynamic KV Rebuild\nACTIVE state only", fillcolor="#EAF5EC", color="#3C8D5A"];
  gate [label="Answerability + Citation Gate", fillcolor="#FFF3DD", color="#D98C2B"];
  answer [label="ANSWER", fillcolor="#EAF5EC", color="#3C8D5A"];
  more [label="SEARCH MORE / CLARIFY / ABSTAIN", fillcolor="#FDECEC", color="#B54B4B"];
  trace [label="Persistence, Checkpoints, Traces, Evals", fillcolor="#F3F5F7", color="#6B7280"];

  request -> route;
  route -> search [label=" grounded / research", fontname="DejaVu Sans", fontsize=9];
  route -> gate [label=" direct", fontname="DejaVu Sans", fontsize=9];
  search -> ledger -> reconstruct -> validate -> commit -> rebuild -> gate;
  gate -> answer [label="supported", fontname="DejaVu Sans", fontsize=9];
  gate -> more [label="insufficient", fontname="DejaVu Sans", fontsize=9];
  more -> search [label="within budget", fontname="DejaVu Sans", fontsize=9];
  {rank=same; answer; more;}
  trace -> route [style=dashed, arrowhead=none];
  trace -> ledger [style=dashed, arrowhead=none];
  trace -> commit [style=dashed, arrowhead=none];
  trace -> gate [style=dashed, arrowhead=none];
}
