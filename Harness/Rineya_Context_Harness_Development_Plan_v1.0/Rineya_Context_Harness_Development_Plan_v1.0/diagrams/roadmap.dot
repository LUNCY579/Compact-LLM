digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad=0.2, nodesep=0.25, ranksep=0.3, splines=ortho];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, color="#17365D", penwidth=1.3, margin="0.12,0.08"];
  edge [color="#5B6B7C", penwidth=1.3, arrowsize=0.7];

  m0 [label="M0\nSpecification freeze", fillcolor="#EAF1F8"];
  m1 [label="M1\nDeterministic state engine", fillcolor="#EAF1F8"];
  m2 [label="M2\nRineya tool protocol", fillcolor="#F2ECF8", color="#6A4C93"];
  m3 [label="M3\nSearch + evidence ledger", fillcolor="#E8F3F4", color="#2A7F8E"];
  m4 [label="M4\nRecursive search-forget loop", fillcolor="#EAF5EC", color="#3C8D5A"];
  m5 [label="M5\nAblations + opportunity frontier", fillcolor="#FFF3DD", color="#D98C2B"];
  m6 [label="M6\nRineya checkpoint qualification", fillcolor="#F2ECF8", color="#6A4C93"];
  m7 [label="M7\nPublic Search demo", fillcolor="#EAF5EC", color="#3C8D5A"];
  m8 [label="M8\nLocal docs / code-terminal profiles", fillcolor="#F3F5F7", color="#6B7280"];

  m0 -> m1 -> m2 -> m3 -> m4 -> m5 -> m6 -> m7 -> m8;
}
