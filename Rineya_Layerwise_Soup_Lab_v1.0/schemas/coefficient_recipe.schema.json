{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rineya layer-wise merge recipe",
  "type": "object",
  "required": ["schema_version", "kind", "global_alpha", "layer_alphas"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"enum": ["merge", "endpoint"]},
    "endpoint": {"type": ["string", "null"], "enum": ["anchor", "greedy", null]},
    "global_alpha": {"type": "number", "minimum": 0, "maximum": 1},
    "layer_alphas": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "group_alphas": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "label": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "endpoint"}}},
      "then": {
        "required": ["endpoint"],
        "properties": {"endpoint": {"enum": ["anchor", "greedy"]}}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "merge"}}},
      "then": {"properties": {"endpoint": {"type": "null"}}}
    }
  ]
}
