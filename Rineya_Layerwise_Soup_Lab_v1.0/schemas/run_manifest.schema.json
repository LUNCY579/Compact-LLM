{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rineya soup run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "config_sha256", "models", "datasets"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "created_at": {"type": "string"},
    "config_sha256": {"type": "string"},
    "models": {"type": "object"},
    "datasets": {"type": "object"}
  }
}
