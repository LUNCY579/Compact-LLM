{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rineya SFT record",
  "type": "object",
  "required": [
    "id",
    "system_policy_version",
    "messages",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "system_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "reply_class",
        "capability_group",
        "length_mode",
        "target_token_min",
        "target_token_max",
        "requires_external_fact",
        "safety_tier",
        "tone",
        "source_provenance",
        "human_review_status",
        "split",
        "template_family"
      ]
    }
  },
  "additionalProperties": false
}