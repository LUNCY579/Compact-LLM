{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F-WANDA paired efficacy result",
  "type": "object",
  "required": ["schema_version", "experiment", "arm", "paired_item_ids", "density", "metrics", "provenance"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "experiment": {"const": "fwanda_delta_retention_v1"},
    "arm": {"enum": ["F0", "F1", "F2"]},
    "paired_item_ids": {"type": "array", "items": {"type": "string"}},
    "density": {"type": "number", "minimum": 0, "maximum": 1},
    "metrics": {
      "type": "object",
      "required": ["target_skill_capability", "retention", "repairs", "damages", "unchanged_correct", "unchanged_incorrect"],
      "properties": {
        "target_skill_capability": {"type": ["number", "null"]},
        "retention": {"type": ["number", "null"]},
        "repairs": {"type": ["integer", "null"]},
        "damages": {"type": ["integer", "null"]},
        "unchanged_correct": {"type": ["integer", "null"]},
        "unchanged_incorrect": {"type": ["integer", "null"]}
      }
    },
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
