{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LUNCY579/ChatBubble/schemas/jumplora-qualification-receipt.schema.json",
  "title": "JLR-QUAL-001 qualification receipt",
  "type": "object",
  "required": ["schema_version", "qualification_id", "experiment_id", "status", "result_classification", "training_occurred", "sealed_access", "checks", "provenance", "resource_peak_measured"],
  "properties": {
    "schema_version": {"type": "string"},
    "qualification_id": {"const": "JLR-QUAL-001"},
    "experiment_id": {"const": "jumplora_rineya_skill_isolation_v1"},
    "status": {"enum": ["PASS", "FAIL"]},
    "result_classification": {"const": "MECHANICAL_ONLY"},
    "training_occurred": {"type": "boolean"},
    "training_scope": {"type": "string"},
    "sealed_access": {"const": false},
    "sealed_paths_touched": {"type": "array", "items": {"type": "string"}},
    "model_loaded": {"type": "boolean"},
    "source_weight_files_read": {"type": "boolean"},
    "checks": {"type": "array", "items": {"type": "object", "required": ["name", "status"], "properties": {"name": {"type": "string"}, "status": {"enum": ["PASS", "FAIL"]}}}},
    "resource_peak_measured": {
      "type": "object",
      "properties": {
        "cuda_peak_memory_allocated_bytes": {"type": ["integer", "null"], "minimum": 0},
        "cuda_peak_memory_reserved_bytes": {"type": ["integer", "null"], "minimum": 0},
        "host_ram_low_water_mark_bytes": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["repository_url", "base_commit", "branch", "code_commit_at_qualification", "model_checkpoint", "tokenizer", "datasets", "precision", "seeds", "runtime"],
      "properties": {
        "repository_url": {"type": "string"},
        "base_commit": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "code_commit_at_qualification": {"type": ["string", "null"]},
        "model_checkpoint": {"type": "object"},
        "tokenizer": {"type": "object"},
        "datasets": {"type": "object"},
        "precision": {"type": "string"},
        "seeds": {"type": "array", "items": {"type": "integer"}},
        "runtime": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
