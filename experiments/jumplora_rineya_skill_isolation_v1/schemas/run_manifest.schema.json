{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LUNCY579/ChatBubble/schemas/jumplora-run-manifest.schema.json",
  "title": "JumpLoRA run manifest",
  "type": "object",
  "definitions": {
    "provenance": {
      "type": "object",
      "required": ["repository_url", "base_commit", "branch", "code_commit_at_qualification", "model_checkpoint", "tokenizer", "datasets", "precision", "seeds", "runtime"],
      "properties": {
        "repository_url": {"type": "string"},
        "base_commit": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "code_commit_at_qualification": {"type": ["string", "null"]},
        "target_remote_branch": {"type": "string"},
        "target_remote_sha_before_work": {"type": "string"},
        "model_checkpoint": {"type": "object"},
        "tokenizer": {"type": "object"},
        "datasets": {"type": "object"},
        "precision": {"type": "string"},
        "seeds": {"type": "array", "items": {"type": "integer"}},
        "config_path": {"type": "string"},
        "config_sha256": {"type": ["string", "null"]},
        "runtime": {"type": "object"},
        "train_eval_counts": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "required": ["schema_version", "experiment_id", "base_commit", "branch", "arms", "provenance", "splits", "resource_measurements", "result_classification"],
  "properties": {
    "schema_version": {"type": "string"},
    "experiment_id": {"const": "jumplora_rineya_skill_isolation_v1"},
    "base_commit": {"type": "string"},
    "branch": {"type": "string"},
    "arms": {"type": "array", "items": {"enum": ["J0", "J1", "J2", "J3"]}, "minItems": 4, "maxItems": 4, "uniqueItems": true},
    "provenance": {"$ref": "#/$defs/provenance"},
    "splits": {"type": "object"},
    "resource_measurements": {"type": "object"},
    "result_classification": {"enum": ["MECHANICAL_ONLY", "QUALIFIED_NOT_RUN", "DEVELOPMENT_RESULT", "CONFIRMATORY_RESULT"]}
  },
  "$defs": {
    "provenance": {"$ref": "#/definitions/provenance"}
  },
  "additionalProperties": true
}
