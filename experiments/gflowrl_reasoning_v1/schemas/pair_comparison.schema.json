{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luncy579.github.io/ChatBubble/gflowrl_reasoning_v1/pair_comparison.schema.json",
  "title": "Matched R0/R1 comparison result",
  "type": "object",
  "required": [
    "experiment",
    "r0_result_sha256",
    "r1_result_sha256",
    "pass_at_1_delta",
    "diversity_deltas",
    "paired_repairs_damages",
    "base_retention",
    "kl_policy_drift",
    "gradient_stability",
    "resources",
    "preregistered_decision"
  ],
  "properties": {
    "experiment": {
      "const": "gflowrl_reasoning_v1"
    },
    "r0_result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "r1_result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pass_at_1_delta": {
      "type": "number"
    },
    "diversity_deltas": {
      "type": "object"
    },
    "paired_repairs_damages": {
      "type": "object",
      "required": [
        "paired_prompts",
        "repairs",
        "damages",
        "net_repairs_minus_damages"
      ]
    },
    "base_retention": {
      "type": "object"
    },
    "kl_policy_drift": {
      "type": "object"
    },
    "gradient_stability": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "preregistered_decision": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "BLOCKED"
      ]
    }
  }
}
