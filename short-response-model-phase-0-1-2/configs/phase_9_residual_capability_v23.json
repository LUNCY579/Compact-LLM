      "anchor_kl_weight": 0.3,
      "anchor_temperature": 1.5,
      "residual_row_kl_multiplier": 0.35,
      "preservation_row_kl_multiplier": 1.0
    },
    "procedure_residual": {
      "learning_rate": 5e-06,
      "max_steps": 140,
      "lora_rank": 16,
      "anchor_kl_weight": 0.35,
      "anchor_temperature": 1.5,
      "residual_row_kl_multiplier": 0.3,
      "preservation_row_kl_multiplier": 1.0
