    "refinement_radius": 0.15,
    "refinement_step": 0.05,
    "minimum_margin_improvement": 0.001,
    "probe_direct_cases": 720,
    "probe_ood_cases": 720,
    "probe_original_rag_cases": 180,
    "probe_procedural_cases": 180,
    "retain_nonwinning_models": false
