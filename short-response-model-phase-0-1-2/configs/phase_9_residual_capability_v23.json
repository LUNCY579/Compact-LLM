{
  "schema_version": "2.3",
  "experiment": {
    "name": "phase9_preservation_constrained_residual_capability_v2_3",
    "primary_question": "Can the sealed-v2.2 greedy anchor acquire genuinely answerable reasoning and hard procedural capabilities from stronger but destructive teachers while preserving its established grounded behavior?",
    "optimization_anchor": "v2.2 greedy_soup (original student + 0.5 * abstention LoRA delta)",
    "historical_anchor": "v2.2 frozen_anchor/original student",
    "anchor_policy": "The greedy v2.2 checkpoint is immutable during v2.3 training and is the KL/reference anchor. The original student remains an immutable historical regression reference.",
    "teacher_policy": "Track A broad, Track B anchored, and the v2.2 procedure specialist are discovery teachers only. Their predictions become residual candidates only when the packaged deterministic gold verifies them as correct.",
    "sealed_policy": "The v2.2 sealed TEST is consumed and MUST NOT be used for v2.3 tuning or selection. v2.3 has a fresh sealed generation that is touched only after one DEV/OOD-DEV candidate is frozen."
  },
  "data": {
    "root": "data/phase_9_student_distillation/residual_capability_v23",
    "direct_reasoning": {
      "canonical_rows": 24300,
      "domains": 27,
      "operations": 12,
      "split_counts": {
        "discovery": 11340,
        "dev": 4860,
        "ood_dev": 4860,
        "fresh_sealed": 3240
      },
      "answerable_fraction_target": 0.8333333333,
      "surface_policy": "Split-disjoint representation families: discovery uses prose/bullets/tables/key-value; DEV uses email/chat/ticket; OOD-DEV uses JSON/YAML/CLI/log; fresh sealed uses XML-like/config/mixed-document representations."
    },
    "procedural_rag": {
      "canonical_rows": 7200,
      "families": 8,
      "topic_count": 1200,
      "variants_per_topic": 6,
      "split_counts": {
        "discovery": 4320,
        "dev": 1080,
        "ood_dev": 1080,
        "fresh_sealed": 720
      },
      "answerable_fraction_target": 0.6666666667,
      "retrieval_selection_policy": "query_aware_v23"
    },
    "preservation_mining_rows": 2500,
    "reasoning_training_rows": 6000,
    "procedure_training_rows": 5000,
    "reasoning_residual_fraction": 0.6,
    "procedure_residual_fraction": 0.48,
    "minimum_reasoning_residual_rows": 250,
    "minimum_procedure_residual_rows": 60,
    "maximum_repeat_factor": 8
  },
  "training": {
