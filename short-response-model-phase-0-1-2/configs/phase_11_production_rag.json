{
  "schema_version": "1.3",
  "experiment": {
    "name": "production_rag_student_release_v2_1",
    "seed": 42,
    "primary_opportunity": "measured_total_process_memory_reduction"
  },
  "routing": {
    "social_roleplay": "direct_student_with_optional_memory_or_lore",
    "grounded_factual": "retrieval_answerability_student_grounding",
    "procedure": "trusted_procedure_plus_factual_evidence",
    "high_risk": "external_boundary_or_approved_fallback",
    "complex": "clarify_abstain_or_approved_fallback"
  },
  "retrieval": {
    "backend": "sqlite_fts5",
    "retrieval_top_k": 20,
    "selected_top_k": 3,
    "maximum_evidence_tokens": 512,
    "neural_retriever": "optional_challenger_only_after_measured_lexical_bottleneck",
    "social_retrieval_top_k": 0,
    "selection_policy": "query_aware_v21",
    "selection_policy_reason": "suppress explicit-locator sibling collisions and deduplicate equivalent procedures; recalibrate answerability after selection changes"
  },
  "answerability": {
    "threshold": null,
    "weights": null,
    "false_answer_cost": 3.0,
    "false_abstention_cost": 1.0,
    "calibration_policy": "development_set_only_recalibrate_after_any_index_or_retriever_change"
  },
  "memory_reconstruction": {
    "default_mode": "off",
    "supported_modes": [
      "off",
      "prompted",
      "trained"
    ],
    "reconstruction_max_new_tokens": 128,
    "invalid_json_policy": "insufficient_then_abstain",
    "source_state_field": "metadata.source_state",
    "validity_conditions_field": "metadata.validity_conditions",
    "current_state_request_field": "current_state",
    "preserve_source_ids": true,
    "evidence_is_data_not_instruction": true,
    "measure_full_two_pass_cost": true,
    "training_corpus_root": "data/phase_9b_memory_reconstruction/reconstruction_corpus_v1",
    "runtime_benchmark_policy": "measure reconstruction as a full additional inference pass when enabled",
    "trained_mode_requires_approved_phase9b_behavior": "required by workflow/handoff, not inferred from a filename",
    "validity_condition_dsl": [
      "all",
      "any",
      "predicate",
      "item",
      "legacy_direct_mapping"
    ]
  },
  "generation": {
    "max_sequence_length": 1024,
    "max_new_tokens": 32,
    "response_control": "one_sentence",
    "do_sample": false
  },
  "grounding": {
    "unsupported_hard_claim_action": "replace_with_abstention",
    "numeric_support_required": true,
    "named_entity_support_required": true,
    "negation_mismatch": "diagnostic_unless_other_hard_failure_exists"
  },
  "quantization": {
    "default_backend": "dense_copy",
    "supported_backends": [
      "dense_copy",
      "bitsandbytes_nf4",
      "bitsandbytes_int8",
      "llamacpp_gguf"
    ],
    "gguf_default_type": "Q4_K_M"
  },
  "evaluation": {
    "unsupported_confident_answer_cap": null,
    "measure": [
      "serialized_model_bytes",
      "knowledge_index_bytes",
      "total_process_rss",
      "peak_vram",
      "retrieval_latency",
      "prefill_probe_latency",
      "generation_latency",
      "end_to_end_latency",
      "supported_correctness",
      "faithfulness",
      "abstention",
      "routing",
      "rollback",
      "memory_reconstruction_validity",
      "memory_reconstruction_latency",
      "memory_reconstruction_prompt_tokens",
      "memory_reconstruction_generated_tokens"
    ]
  },
  "release": {
    "package_mode": "manifest",
    "human_gate_required": true,
    "dense_release_is_valid_when_quantization_has_no_net_measured_gain": true
  },
  "data_contract": {
    "rag_reasoning_corpus_root": "data/phase_9_student_distillation/rag_reasoning_v2",
    "knowledge_file": "data/phase_9_student_distillation/rag_reasoning_v2/knowledge.jsonl",
    "procedures_file": "data/phase_9_student_distillation/rag_reasoning_v2/procedures.jsonl",
    "answerability_calibration_split": "dev",
    "sealed_runtime_benchmark_split": "test",
    "memory_reconstruction_corpus_root": "data/phase_9b_memory_reconstruction/reconstruction_corpus_v1"
  }
}
