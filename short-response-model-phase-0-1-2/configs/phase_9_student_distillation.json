          "max_position_embeddings": 1024,
          "target_params": 130000000,
          "target_params_tolerance": 0.12,
          "production_eligible_by_default": false,
          "research_control": true
        },
        "narrow_170m": {
          "mode": "custom_qwen_random",
          "hidden_size": 640,
          "intermediate_size": 1792,
          "num_hidden_layers": 16,
          "num_attention_heads": 10,
          "num_key_value_heads": 2,
          "head_dim": 64,
          "max_position_embeddings": 1024,
          "target_params": 168000000,
          "target_params_tolerance": 0.12,
          "production_eligible_by_default": false,
          "research_control": true
        }
      }
    }
  },
  "training": {
    "max_sequence_length": 512,
    "max_completion_tokens": 32,
    "per_device_batch_size": 1,
    "gradient_accumulation_steps": 32,
    "learning_rate": 5e-05,
    "warmup_ratio": 0.05,
    "epochs": 3,
    "gradient_checkpointing": true,
    "default_max_steps": 600,
    "curriculum_enabled": true,
    "curriculum": {
      "canonical_repeats": 2,
      "prompt_variants": 2,
      "distractor_variants": 2,
      "missing_evidence_variants": 2,
      "injection_variants": 1,
      "policy": "human-approved answers only; controlled evidence transformations; no invented facts",
      "social_repeats": 2
    },
    "research_readiness": {
      "minimum_reviewed_rows": 30,
      "minimum_connected_groups": 8,
      "minimum_dev_rows": 3,
      "minimum_test_rows": 4,
      "smoke_test_requires_explicit_flag": true
    },
    "progressive_sequence": [
      "human_reviewed_split",
      "real_behavior_curriculum",
      "synthetic_behavior_foundation",
      "deterministic_weighted_mix",
      "curriculum_sft",
      "confidence_filtered_completion_kd",
      "optional_on_policy_kd"
    ],
    "direct_kd_from_initialization": "optional_ablation_only",
    "synthetic_behavior_foundation": {
      "enabled_by_default": true,
      "path": "data/phase_9_student_distillation/foundation/prompts.foundation.jsonl",
      "authored_prompt_rows": 336,
      "primary_curriculum_repeat": 3,
      "foundation_repeat": 1,
      "policy": "training-only fictional evidence; never used as held-out quality evidence; supplements but does not replace human-reviewed real data or broad language pretraining",
      "skills": [
        "supported extraction",
        "exact abstention",
        "distractor resistance",
        "retrieval injection resistance",
        "conflict recognition",
        "procedure application",
        "concise social response",
        "EOS behavior"
      ]
    },
    "behavior_token_weighting": {
      "first_answer_token_weight": 2.0,
      "evidence_anchor_token_weight": 1.75,
      "abstention_token_weight": 2.0,
      "completion_boundary_weight": 1.5,
      "policy": "simple observable completion-token weighting; no hidden-state or representation loss"
    },
    "behavior_mixture": {
      "supported": 0.45,
      "unsupported": 0.25,
      "conflict": 0.1,
      "injection": 0.1,
      "procedure": 0.05,
      "social": 0.05,
      "policy": "deterministic sampled training view; original reviewed and curriculum artifacts remain unchanged"
    },
    "grounded_recovery_ladder": {
      "official_order": [
        "teacher_oracle_preflight",
        "warm_initialization_oracle_baseline",
        "tiny_deliberate_overfit",
        "full_oracle_sft",
        "real_retrieval",
        "progressive_kd",
        "architecture_comparison"
      ],
      "overfit_unique_rows": 18,
      "overfit_repeat": 12,
      "overfit_max_steps": 300,
      "overfit_minimum_score": 0.8,
      "overfit_minimum_improvement": 0.25,
      "overfit_threshold_scope": "technical wiring test only; not a production quality floor",
      "warm_sft_sweep": [
        {
          "name": "lr5e5_s600",
          "learning_rate": 5e-05,
          "max_steps": 600,
          "lora_rank": 16,
          "seed": 42
        },
        {
          "name": "lr5e5_s1200",
          "learning_rate": 5e-05,
          "max_steps": 1200,
          "lora_rank": 16,
          "seed": 42
        },
        {
          "name": "lr1e4_s1200",
          "learning_rate": 0.0001,
          "max_steps": 1200,
          "lora_rank": 16,
          "seed": 42
        }
      ],
      "rank32_policy": "run only when rank16 demonstrably underfits",
      "seed_policy": "rerun best setting with at least one additional seed before production selection",
      "kd_policy": "progressive KD only after full Oracle-RAG SFT improves over warm initialization",
      "architecture_sweep_policy": "narrow random controls remain blocked until overfit and full Oracle stages pass",
      "selection_benchmark": "dev",
      "sealed_final_benchmark": "test",
      "foundation_holdout_filtering": "exclude dev/test question overlaps before training mixture"
    },
    "evidence_preference_refinement": {
      "enabled_by_default": false,
      "when_allowed": "only after warm SFT demonstrates Oracle-RAG capability on dev",
      "train_preferences": "data/phase_9_student_distillation/rag_reasoning_v2/preferences/train.jsonl",
      "dev_preferences": "data/phase_9_student_distillation/rag_reasoning_v2/preferences/dev.jsonl",
      "trainer": "scripts/phase_3_preference_alignment/train_dpo.py",
      "wrapper": "scripts/phase_9_student_distillation/run_evidence_preference_refinement.ps1",
      "selection_rule": "evaluate on dev; never choose DPO vs SFT using sealed test"
    }
  },
  "distillation": {
    "temperature": 2.0,
    "hard_label_weight": 0.25,
    "logit_weight": 0.75,
    "completion_only": true,
    "same_tokenizer_required": true,
    "hidden_state_weight": 0.0,
    "attention_weight": 0.0,
    "on_policy_rounds": [
      {
        "student_generated_fraction": 0.2,
        "teacher_reference_fraction": 0.8
      },
      {
        "student_generated_fraction": 0.5,
        "teacher_reference_fraction": 0.5
      },
      {
        "student_generated_fraction": 0.75,
        "teacher_reference_fraction": 0.25
      }
    ],
    "hard_label_weight_start": 0.75,
    "hard_label_weight_end": 0.25,
    "kd_warmup_ratio": 0.15,
    "teacher_confidence_floor": 0.02,
    "eos_loss_weight": 1.5,
    "teacher_confidence_policy": "fall back to hard labels on low-confidence approved target tokens",
    "primary_candidate": "progressive_kd_from_sft",
    "direct_kd_candidate": "optional_ablation"
  },
  "rag": {
    "retrieval_top_k": 20,
    "reranked_top_k": 3,
    "maximum_evidence_tokens": 384,
    "minimum_retrieval_score": null,
    "minimum_coverage_score": null,
    "abstention_text": "I don't know based on the available information.",
    "threshold_policy": "calibrate_on_development_data; do_not_invent_universal_thresholds"
  },
  "generation": {
    "do_sample": false,
    "max_new_tokens": 32,
    "response_control": "eos_only"
  },
  "evaluation": {
    "conditions": [
      "closed_book",
      "oracle_rag",
      "real_rag",
      "adversarial_rag",
      "adversarial_passthrough_rag"
    ],
    "unsupported_confident_answer_cap": null,
    "promotion_policy": "shared_relative_opportunity_engine_plus_explicit_human_gate",
    "schema_version": "1.3",
    "case_classes": [
      "supported",
      "unsupported",
      "conflict",
      "social",
      "unknown"
    ],
    "denominator_policy": "return null when a metric has zero applicable cases; never divide by max(1,n)",
    "functional_correctness": "explicit response contract plus grounding; broad quality score remains diagnostic",
    "comparison_policy": "shared relative opportunity plus Phase 9 task-contract deficiency; bounded zero-reference deltas for training comparisons",
    "production_readiness": "requires non-degenerate supported answering, abstention, prompt/decode integrity, and adversarial evidence diagnostics",
    "adversarial_conditions": {
      "adversarial_rag": "system sanitizer active; measures complete-stack filtering",
      "adversarial_passthrough_rag": "malicious evidence retained; measures model-level instruction resistance"
    },
    "prompt_integrity_policy": "budget passages before chat rendering; preserve system contract and final question; never use silent tokenizer truncation",
    "reference_comparisons": [
      "candidate_vs_teacher",
      "sft_vs_initialization",
      "kd_vs_sft",
      "kd_vs_initialization"
    ],
    "degenerate_frontier_policy": "emit NO_VALID_QUALITY_FRONTIER when no candidate demonstrates non-degenerate Oracle capability"
  },
  "dataset": {
    "default_corpus_root": "data/phase_9_student_distillation/rag_reasoning_v2",
    "schema_version": "2.1",
    "authored_split_policy": "preserve_intended_split",
    "train_rows": 392,
    "dev_rows": 67,
    "test_rows": 71,
    "sealed_test_policy": "all model/hyperparameter/recovery selection uses dev; test is evaluated only after final candidate freeze",
    "preference_train_pairs": 1176,
    "preference_dev_pairs": 201,
    "evaluator_calibration_cases": 1836,
    "heldout_evaluator_cases": 284
