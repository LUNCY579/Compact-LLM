{
  "schema_version": "1.0",
  "package_version": "1.7.6",
  "playground_version": "1.0",
  "default_dataset": "Student_Distillation_Playground_v1.0/datasets/showcase_suite.jsonl",
  "default_output_root": "playground_artifacts/student_distillation_showcase",
  "generation": {
    "max_sequence_length": 1024,
    "max_new_tokens": 32,
    "reconstruction_max_new_tokens": 128,
    "do_sample": false,
    "response_control": "eos_only"
  },
  "policy": {
    "official_gate_evidence": false,
    "selection_use_forbidden": true,
    "reason": "Playground cases are exploratory/showcase data and are intentionally outside the governed official phase benchmarks."
  }
}
