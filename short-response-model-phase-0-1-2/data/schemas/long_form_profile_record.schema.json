{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Long-form component profiling record",
  "type": "object",
  "required": ["id", "messages", "metadata"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object",
      "required": ["length_class", "category", "source_provenance"],
      "properties": {
        "length_class": {"enum": ["short", "long"]},
        "category": {"type": "string"},
        "source_provenance": {"type": "string"},
        "safety_tier": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
