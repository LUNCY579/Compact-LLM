{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "prediction"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^RRFR2-[0-9a-f]{24}$"
    },
    "prediction": {
      "type": "string"
    },
    "sample_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 127
    },
    "finish_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "completion_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "reasoning_tokens": {
      "type": "integer",
      "minimum": 0
    }
  }
}
