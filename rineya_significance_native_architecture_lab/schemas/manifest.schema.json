{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rineya.local/schemas/significance-run-manifest-v1.json",
  "title": "Rineya Significance Lab Run Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "evidence_class",
    "created_at",
    "repositories",
    "experiment",
    "config",
    "model",
    "runtime"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["NOT_RUN", "RUNNING", "COMPLETE", "FAILED", "INVALID_OR_CONFOUNDED"]
    },
    "evidence_class": {
      "enum": [
        "NOT_RUN",
        "INHERITED_SOURCE_EVIDENCE",
        "EXISTING_CHATBUBBLE_EVIDENCE",
        "NEW_CHATBUBBLE_EVIDENCE",
        "INVALID_OR_CONFOUNDED"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "repositories": {
      "type": "object",
      "required": ["chatbubble", "source"],
      "properties": {
        "chatbubble": {
          "type": "object",
          "required": ["remote", "commit"],
          "properties": {
            "remote": { "const": "https://github.com/LUNCY579/ChatBubble.git" },
            "commit": { "$ref": "#/$defs/sha1" },
            "dirty": { "type": ["boolean", "null"] }
          },
          "additionalProperties": true
        },
        "source": {
          "type": "object",
          "required": ["remote", "implementation", "paper"],
          "properties": {
            "remote": { "const": "https://github.com/LUNCY579/RineyaBeta.git" },
            "implementation": { "$ref": "#/$defs/sourceArtifact" },
            "paper": { "$ref": "#/$defs/sourceArtifact" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "experiment": {
      "type": "object",
      "required": ["name", "compute_tier", "architecture_variant"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "compute_tier": { "enum": ["A", "B", "C", "D"] },
        "architecture_variant": { "type": "string", "minLength": 1 },
        "benchmark": { "type": ["string", "null"] },
        "seed": { "type": ["integer", "null"] },
        "query_conditioned": { "type": ["boolean", "null"] }
      },
      "additionalProperties": true
    },
    "config": {
      "type": "object",
      "required": ["resolved_path", "sha256"],
      "properties": {
        "resolved_path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "required": ["status", "id", "path", "hashes"],
      "properties": {
        "status": { "enum": ["UNRESOLVED", "HASH_RECORDED", "VERIFIED", "MISMATCH", "NOT_APPLICABLE"] },
        "id": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "architecture": { "type": ["string", "null"] },
        "hashes": {
          "type": "object",
          "properties": {
            "weights": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "tokenizer": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "config": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "chat_template": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": ["python", "torch", "transformers", "device", "precision"],
      "properties": {
        "python": { "type": ["string", "null"] },
        "torch": { "type": ["string", "null"] },
        "transformers": { "type": ["string", "null"] },
        "device": { "type": ["string", "null"] },
        "precision": { "type": ["string", "null"] },
        "hardware": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "budget": {
      "type": ["object", "null"],
      "properties": {
        "resident_entries": { "type": ["integer", "null"], "minimum": 0 },
        "kv_only_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "total_persistent_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "matched": { "type": ["boolean", "null"] }
      },
      "additionalProperties": true
    },
    "artifacts": { "type": "object", "additionalProperties": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceArtifact": {
      "type": "object",
      "required": ["ref", "commit", "path", "blob"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/sha1" },
        "path": { "type": "string", "minLength": 1 },
        "blob": { "$ref": "#/$defs/sha1" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
