{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rineya.local/schemas/significance-case-v1.json",
  "title": "Rineya Significance Lab Scored Case",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "condition",
    "task_family",
    "prompt_sha256",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": ["string", "null"] },
    "condition": { "type": "string", "minLength": 1 },
    "task_family": {
      "enum": ["R0", "R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8", "R9"]
    },
    "generator_seed": { "type": ["integer", "null"] },
    "prompt_sha256": { "$ref": "#/$defs/sha256" },
    "context_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "evidence_depth": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "chunk_size": { "type": ["integer", "null"], "minimum": 1 },
    "status": {
      "enum": ["NOT_RUN", "OK", "ERROR", "INVALID", "INTERRUPTED"]
    },
    "prediction": { "type": ["string", "null"] },
    "correct": { "type": ["boolean", "null"] },
    "full_cache_correct": { "type": ["boolean", "null"] },
    "compression_conditioned_eligible": { "type": ["boolean", "null"] },
    "evidence": {
      "type": ["object", "null"],
      "properties": {
        "required_count": { "type": "integer", "minimum": 0 },
        "surviving_count_final": { "type": "integer", "minimum": 0 },
        "all_required_survived": { "type": ["boolean", "null"] },
        "distractors_retained": { "type": ["integer", "null"], "minimum": 0 },
        "stale_items_retained": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "efficiency": {
      "type": ["object", "null"],
      "properties": {
        "kv_only_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "total_persistent_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "wall_seconds": { "type": ["number", "null"], "minimum": 0 },
        "peak_rss_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "peak_vram_bytes": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "failure_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/failureLabel" },
      "uniqueItems": true
    },
    "trace_ids": { "type": "array", "items": { "type": "string" } },
    "error": { "type": ["string", "null"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "failureLabel": {
      "enum": [
        "FULL_CACHE_CAPABILITY_FAILURE",
        "BASE_MODEL_REASONING_FAILURE",
        "EVIDENCE_NEVER_SCORED",
        "EVIDENCE_LOW_SIGNIFICANCE",
        "EXPOSURE_BIAS",
        "EVIDENCE_EVICTED",
        "EVIDENCE_PARTIALLY_RETAINED",
        "DISTRACTOR_OUTRANKED_EVIDENCE",
        "STALE_INFORMATION_PERSISTED",
        "QUERY_SIMILARITY_FALSE_POSITIVE",
        "ATTENTION_FEEDBACK_COLLAPSE",
        "MEMORY_SLOT_INFORMATION_LOSS",
        "INSUFFICIENT_KV_BUDGET",
        "POSITIONAL_ENCODING_FAILURE",
        "DECODE_FAILURE",
        "IMPLEMENTATION_ERROR",
        "UNKNOWN"
      ]
    }
  },
  "additionalProperties": true
}

