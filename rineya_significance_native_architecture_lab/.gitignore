# Local model material must never be copied into the lab.
*.safetensors
*.bin
*.gguf
*.pt
*.pth

# Raw traces and per-run model outputs can be very large. Track their hashes,
# summaries, frozen configs, and selected final figures instead.
results/traces/*
!results/traces/.gitkeep
!results/traces/README.md
results/runs/*
!results/runs/.gitkeep
# The reviewed Halo run is the current published-core deliverable. Earlier R2
