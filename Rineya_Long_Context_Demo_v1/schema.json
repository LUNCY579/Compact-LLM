{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rineya Long-Context Demonstration Suite full row",
  "type": "object",
  "required": [
    "id",
    "scenario_id",
    "split",
    "variant",
    "domain",
    "domain_label",
    "title",
    "task_type",
    "difficulty",
    "needle_profile",
    "length_bucket",
    "answerable",
    "context",
    "question",
    "prompt",
    "messages",
    "answer",
    "accepted_answers",
    "normalized_accepted_answers",
    "supporting_facts",
    "context_words",
    "prompt_words",
    "context_sha256",
    "intended_use"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^RLC-[0-9]{3}-[BPCU]$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^RLC-[0-9]{3}$"
    },
    "split": {
      "enum": [
        "showcase",
        "stability_test"
      ]
    },
    "variant": {
      "enum": [
        "base",
        "paraphrase",
        "counterfactual",
        "unanswerable"
      ]
    },
    "domain": {
      "type": "string"
    },
    "domain_label": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "medium",
        "hard"
      ]
    },
    "needle_profile": {
      "enum": [
        "early",
        "middle",
        "late",
        "distributed"
      ]
    },
    "length_bucket": {
      "enum": [
        "compact_long",
        "standard_long",
        "extended_long"
      ]
    },
    "answerable": {
      "type": "boolean"
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "accepted_answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "normalized_accepted_answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "supporting_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "context_words": {
      "type": "integer",
      "minimum": 1
    },
    "prompt_words": {
      "type": "integer",
      "minimum": 1
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "license": {
      "type": "string"
    },
    "intended_use": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
