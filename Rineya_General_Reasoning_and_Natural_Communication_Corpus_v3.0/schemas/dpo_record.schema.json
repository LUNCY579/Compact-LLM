{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rineya v3 DPO record",
  "type": "object",
  "required": [
    "id",
    "prompt",
    "chosen",
    "rejected",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rineya_v3_dpo__"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "chosen": {
      "type": "string",
      "minLength": 1
    },
    "rejected": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "required": [
        "source_sft_id",
        "reply_class",
        "failure_mode",
        "split"
      ]
    }
  },
  "additionalProperties": false
}