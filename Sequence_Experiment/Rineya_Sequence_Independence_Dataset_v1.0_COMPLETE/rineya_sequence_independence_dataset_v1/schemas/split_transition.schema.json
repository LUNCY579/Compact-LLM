{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rineya-sequence-independence/split-transition.schema.json",
  "title": "Rineya sequence-free compact-state transition record",
  "type": "object",
  "required": [
    "schema_version",
    "variant",
    "transition_id",
    "problem_id",
    "split",
    "domain",
    "category",
    "step_index",
    "total_steps",
    "problem",
    "current_state",
    "target_step",
    "next_state",
    "done",
    "messages",
    "stateful_rollout_messages",
    "source_pair_sha256",
    "sequence_free_training"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "variant": {"const": "split_transition"},
    "transition_id": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "dev", "test"]},
    "domain": {"type": "string"},
    "category": {"type": "string"},
    "difficulty": {"type": "integer", "minimum": 1, "maximum": 3},
    "step_index": {"type": "integer", "minimum": 1},
    "total_steps": {"type": "integer", "minimum": 2},
    "problem": {"type": "string", "minLength": 1},
    "current_state": {"type": "string", "minLength": 1},
    "target_step": {"type": "string", "minLength": 1},
    "next_state": {"type": "string", "minLength": 1},
    "done": {"type": "boolean"},
    "final_answer": {"type": ["string", "null"]},
    "messages": {"type": "array", "minItems": 2, "maxItems": 2},
    "stateful_rollout_messages": {"type": "array", "minItems": 2, "maxItems": 2},
    "stateful_rollout_target": {"type": "string"},
    "source_pair_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sequence_free_training": {"const": true},
    "state_construction": {"const": "derived_from_complete_canonical_trajectory"}
  },
  "additionalProperties": true
}
