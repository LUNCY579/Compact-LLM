{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rineya-sequence-independence/full-context.schema.json",
  "title": "Rineya full-context reasoning record",
  "type": "object",
  "required": [
    "schema_version",
    "variant",
    "problem_id",
    "split",
    "domain",
    "category",
    "problem",
    "answer",
    "full_response",
    "reasoning_steps",
    "compact_state_trace",
    "step_count",
    "messages",
    "source_pair_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "variant": {"const": "full_context"},
    "problem_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "dev", "test"]},
    "domain": {"type": "string"},
    "category": {"type": "string"},
    "difficulty": {"type": "integer", "minimum": 1, "maximum": 3},
    "problem": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "answer_type": {"type": "string"},
    "full_response": {"type": "string", "minLength": 1},
    "reasoning_steps": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "compact_state_trace": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "step_count": {"type": "integer", "minimum": 2},
    "messages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "source_pair_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
