{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rineya.example/schemas/tgsa-mtp-phase2-matrix-v1.json",
  "title": "TGSA x MTP Phase-2 matrix manifest",
  "type": "object",
  "required": [
    "schema_version", "status", "study_id", "confirmatory",
    "expected_base_commit", "config_sha256", "dataset_manifest_sha256",
    "seeds", "primary_arms", "runs", "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "tgsa.mtp-factorial-matrix.v1"},
    "status": {"const": "complete"},
    "study_id": {"type": "string", "minLength": 1},
    "confirmatory": {"type": "boolean"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true},
    "primary_arms": {
      "const": ["parallel_ar", "parallel_mtp", "tgsa_ar", "tgsa_mtp"]
    },
    "runs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["arm", "seed", "manifest"]
      }
    }
  },
  "additionalProperties": true
}
