{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rineya.invalid/schemas/tgsa.phase2-mtp-report.v1.json",
  "title": "TGSA Phase 2 MTP report",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "status",
    "confirmatory",
    "decision",
    "competence_precondition",
    "cells",
    "seeds",
    "runs",
    "initialization_audits",
    "analysis",
    "source",
    "claim_scope",
    "next_gate"
  ],
  "properties": {
    "schema_version": {"const": "tgsa.phase2-mtp-report.v1"},
    "study_id": {"type": "string", "minLength": 1},
    "status": {"const": "complete"},
    "confirmatory": {"type": "boolean"},
    "decision": {"enum": ["smoke_only", "descriptive_only"]},
    "competence_precondition": {
      "type": "object",
      "required": ["required", "verdict"],
      "properties": {
        "required": {"type": "boolean"},
        "verdict": {"type": "string"}
      },
      "additionalProperties": true
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tgsa_arm", "mtp_mode", "key"],
        "properties": {
          "tgsa_arm": {"type": "string"},
          "mtp_mode": {"enum": ["dormant", "backbone", "trajectory"]},
          "key": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer"},
      "uniqueItems": true
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "phase2_mtp_run.schema.json"}
    },
    "initialization_audits": {"type": "array", "minItems": 1},
    "analysis": {
      "type": "object",
      "required": ["contrasts", "decision", "reason"],
      "properties": {
        "contrasts": {"type": "object"},
        "decision": {"const": "descriptive_only"},
        "reason": {"type": "string"}
      },
      "additionalProperties": true
    },
    "source": {"type": "object"},
    "claim_scope": {"type": "string", "minLength": 1},
    "next_gate": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
