{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rineya.invalid/schemas/v5_1_programme_verification.schema.json",
  "title": "TGSA v5.1 programme verification",
  "type": "object",
  "required": [
    "schema_version",
    "passed",
    "checks",
    "errors",
    "programme_sha256",
    "contract_path",
    "repo_root",
    "repo_head",
    "source_plan_path",
    "source_plan_expected_blob_sha1",
    "source_plan_committed_blob_sha1",
    "source_plan_worktree_blob_sha1",
    "claim_scope"
  ],
  "properties": {
    "schema_version": {"const": "tgsa.v5-1-programme-verification.v1"},
    "passed": {"type": "boolean"},
    "checks": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {"type": "boolean"}
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "programme_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "contract_path": {"type": "string"},
    "repo_root": {"type": "string"},
    "repo_head": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        {"type": "null"}
      ]
    },
    "source_plan_path": {"type": "string"},
    "source_plan_expected_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_plan_committed_blob_sha1": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        {"type": "null"}
      ]
    },
    "source_plan_worktree_blob_sha1": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        {"type": "null"}
      ]
    },
    "claim_scope": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
